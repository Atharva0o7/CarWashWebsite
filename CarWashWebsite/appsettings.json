{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=carwash;Username=postgres;Password=abc123"
  },
  "Admin": {
    "Ports": [ 5300, 7300 ]
  },
  "WhatsApp": {
    // "Logging" records what would be sent and delivers nothing (no credentials needed).
    // Switch to "CloudApi" once you have a Meta Business account with approved templates,
    // and put PhoneNumberId / AccessToken in user-secrets — never here.
    "Provider": "Logging",
    "Enabled": true,
    "GraphApiVersion": "v21.0",
    "DefaultCountryCode": "91",
    "DailyRunHour": 10,
    "QuietHoursStart": 21,
    "QuietHoursEnd": 9,
    "WashesRemainingLeadDays": 5,
    "RenewalLeadDays": 3,
    "WinBackAfterDays": 42,
    "MaxMessagesPerRun": 200,
    "Templates": {
      "WashesRemaining": "washes_remaining",
      "Renewal": "plan_renewal",
      "BookingTomorrow": "booking_tomorrow",
      "WinBack": "winback_offer"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
