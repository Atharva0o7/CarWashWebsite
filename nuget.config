<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    Overrides the machine-wide packageSourceMapping allowlist, which only listed a
    fixed set of package IDs and blocked the transitive packages + targeting packs
    that a net8.0 restore needs. With a single public source there is no
    dependency-confusion risk, so a wildcard mapping is correct here.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
